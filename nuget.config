<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Resolves LoupixDeck.PluginSdk from the sibling SDK repository's local feed
    during development. Clone the repositories side by side:

        <parent>/LoupixDeck.PluginSdk/
        <parent>/LoupixDeck.Plugin.Obs/

    Build the SDK once (dotnet build -c Release) so the .nupkg exists.
  -->
  <packageSources>
    <add key="LoupixDeck.PluginSdk (local)" value="..\LoupixDeck.PluginSdk\nupkg" />
  </packageSources>
</configuration>
